<!doctype html>
<html lang="zh-Hant">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="ESP32 Lab: Sensors, MQTT, TFT & E-Paper Integration Practice. 智慧電子實務應用 860 小時軟硬體整合成果展示。">
  <title>ESP32 Lab · Sensors · MQTT · TFT · E-Paper Integration</title>
  <link rel="stylesheet" href="styles.css">
  <link rel="stylesheet" href="theme.css">
  <link rel="stylesheet" href="recommendations.css">
  <link rel="stylesheet" href="bright.css">
</head>
<body>
  <header class="hero">
    <nav class="nav shell">
      <a class="brand" href="."><span class="brand-mark">✦</span> ESP32 IoT Lab</a>
      <div class="nav-links">
        <a href="#highlights">技術亮點</a>
        <a href="#architecture">系統架構</a>
        <a href="#gallery">成果照片</a>
        <a href="#examples">範例索引</a>
        <a href="#author">關於作者</a>
        <a class="nav-button" href="https://github.com/fersz0614/esp32-sensors-mqtt-tft-epaper-Hsiang" target="_blank" rel="noreferrer">GitHub Repo ↗</a>
      </div>
    </nav>

    <!-- 跑馬燈動態展示 -->
    <div class="ticker" aria-label="專案跑馬燈">
      <div class="ticker-track">
        <span>⚡ ESP32 FIRMWARE</span>
        <span>◆ MQTT TELEMETRY & CONTROL</span>
        <span>▣ SPI ILI9225 TFT</span>
        <span>▰ E-PAPER STATUS DASHBOARD</span>
        <span>● 860-HOUR PRACTICE</span>
        <span><b>BUILD · CONNECT · DISPLAY</b></span>
        <span>⚡ ESP32 FIRMWARE</span>
        <span>◆ MQTT TELEMETRY & CONTROL</span>
        <span>▣ SPI ILI9225 TFT</span>
        <span>▰ E-PAPER STATUS DASHBOARD</span>
        <span>● 860-HOUR PRACTICE</span>
        <span><b>BUILD · CONNECT · DISPLAY</b></span>
      </div>
    </div>

    <!-- Hero 主視圖 -->
    <div class="hero-content shell">
      <div class="hero-copy">
        <p class="eyebrow">SMART ELECTRONICS · EMBEDDED & IoT INTEGRATION</p>
        <h1>ESP32 邊緣控管<br><em>與多端物聯網實戰</em></h1>
        <p class="lede">一套模組化的嵌入式韌體專案。涵蓋感測器驅動、GPIO / ADC 時序解析、I²C / SPI 雙匯流排顯示控制，以及 Wi-Fi / MQTT / HTTP API 雙向雲端串接。</p>
        
        <div class="hero-actions">
          <a class="button primary" href="#examples">探索 Lab 範例 <span>↓</span></a>
          <a class="button ghost" href="https://github.com/fersz0614/esp32-sensors-mqtt-tft-epaper-Hsiang" target="_blank" rel="noreferrer">檢視 GitHub 原始碼 ↗</a>
        </div>
      </div>

      <div class="hero-visual" aria-label="電子紙成果照片">
        <div class="orbit orbit-a"></div>
        <div class="orbit orbit-b"></div>
        <div class="device">
          <div class="device-screen">
            <span>ESP32</span>
            <strong>27.4°C</strong>
            <small>MQTT ONLINE</small>
          </div>
          <div class="device-pins"></div>
        </div>
        <div class="floating-chip chip-one">DHT11 / LDR</div>
        <div class="floating-chip chip-two">MQTT / HTTP</div>
        <div class="floating-chip chip-three">E-PAPER / TFT</div>
      </div>
    </div>
  </header>

  <main>
    <!-- 核心技術亮點 -->
    <section class="section shell" id="highlights">
      <div class="section-heading">
        <p class="eyebrow">TECHNICAL HIGHLIGHTS</p>
        <h2>模組化韌體架構，<br><span>打造高擴充性的嵌入式系統。</span></h2>
      </div>
      <div class="feature-grid">
        <article class="feature-card">
          <div class="icon">◌</div>
          <h3>感測與底層驅動</h3>
          <p>精確處理 DHT11 單線協定、超音波微秒級 (µs) 時序，與 LDR 類比訊號 ADC 轉換與判讀。</p>
        </article>
        <article class="feature-card accent">
          <div class="icon">⌁</div>
          <h3>多協定網路傳輸</h3>
          <p>實作 Wi-Fi 連線管理、MQTT 數據遙測上報與遠端控制，整合 ThingSpeak 雲端與 LINE 即時告警。</p>
        </article>
        <article class="feature-card">
          <div class="icon">▣</div>
          <h3>多終端顯示繪製</h3>
          <p>操控 I²C OLED 即時數據繪製、SPI ILI9225 彩色 TFT 介面與低功耗 E-Paper 電子紙狀態儀表板。</p>
        </article>
      </div>
    </section>

    <!-- 系統架構 -->
    <section class="architecture section shell" id="architecture">
      <div class="section-heading">
        <p class="eyebrow">SYSTEM ARCHITECTURE</p>
        <h2>標準四層邊緣物聯網架構，<br><span>資料串流一目瞭然。</span></h2>
      </div>
      <div class="flow">
        <div class="flow-node">
          <strong>01 · SENSOR</strong>
          <span>DHT11 · PIR · LDR<br>超音波 · RGB LED</span>
        </div>
        <div class="flow-icon">→</div>
        <div class="flow-node">
          <strong>02 · ESP32 CORE</strong>
          <span>GPIO / ADC 時序解碼<br>I²C / SPI 匯流排控制</span>
        </div>
        <div class="flow-icon">→</div>
        <div class="flow-node">
          <strong>03 · CONNECT & CLOUD</strong>
          <span>Wi-Fi · MQTT Broker<br>ThingSpeak · LINE API</span>
        </div>
        <div class="flow-icon">→</div>
        <div class="flow-node">
          <strong>04 · DISPLAY TERMINAL</strong>
          <span>OLED · ILI9225 TFT<br>E-Paper 低功耗儀表</span>
        </div>
      </div>
    </section>

    <!-- 成果展照片 -->
    <section class="gallery-section" id="gallery">
      <div class="shell">
        <div class="section-heading light">
          <p class="eyebrow">PROJECT IN ACTION</p>
          <h2>硬體實作與動態展示，<br><span>視覺化邊緣狀態。</span></h2>
        </div>
        <div class="gallery">
          <figure class="gallery-main">
            <img src="assets/photo-32.png" alt="電子紙 MQTT 成果">
            <figcaption>E-Paper 低功耗狀態儀表 × MQTT</figcaption>
          </figure>
          <figure>
            <img src="assets/photo-11.png" alt="DHT11 OLED ThingSpeak 成果">
            <figcaption>DHT11 × OLED × ThingSpeak 雲端圖表</figcaption>
          </figure>
          <figure>
            <img src="assets/photo-28.jpeg" alt="TFT MQTT 成果">
            <figcaption>ILI9225 TFT 彩色 UI × MQTT</figcaption>
          </figure>
          <figure>
            <img src="assets/photo-22.png" alt="MQTT 控制成果">
            <figcaption>MQTT 雙向遠端控制實測</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- 範例索引與搜尋 -->
    <section class="section shell" id="examples">
      <div class="section-heading examples-heading">
        <div>
          <p class="eyebrow">EXAMPLE INDEX</p>
          <h2>探索 Lab 範例，<span>快速查看程式模組。</span></h2>
        </div>
        <div class="search-wrap">
          <label for="search">搜尋範例</label>
          <input id="search" type="search" placeholder="例如：MQTT、TFT、E-Paper、DHT11">
        </div>
      </div>
      <div class="filters" role="group" aria-label="範例分類">
        <button class="filter active" data-filter="all">全部範例</button>
        <button class="filter" data-filter="basic">基礎與感測器</button>
        <button class="filter" data-filter="network">網路與 MQTT</button>
        <button class="filter" data-filter="display">顯示器模組</button>
      </div>
      <div id="example-grid" class="example-grid"></div>
      <p id="empty" class="empty" hidden>找不到符合關鍵字的範例。</p>
    </section>

    <!-- 關於作者與背景 -->
    <section class="section shell" id="author">
      <div class="section-heading">
        <p class="eyebrow">ABOUT THE AUTHOR</p>
        <h2>關於作者與訓期累積，<br><span>具備即戰力的軟硬體整合能力。</span></h2>
      </div>
      <div class="feature-grid">
        <article class="feature-card">
          <h3>🎓 專業受訓背景</h3>
          <p>完成 <strong>860 小時智慧電子實務應用專業訓練</strong>，累積完整專案開發經驗。</p>
        </article>
        <article class="feature-card accent">
          <h3>⚡ 韌體與通訊核心</h3>
          <p>精通 C/C++ 嵌入式開發、ESP32 周邊驅動 (GPIO/ADC/PWM)、SPI/I²C 匯流排及 MQTT/HTTP 通訊架構。</p>
        </article>
        <article class="feature-card">
          <h3>🔧 硬體與 PCB 設計</h3>
          <p>具備電路圖繪製、基本 PCB Layout 與硬體訊號除錯觀念，能獨當一面完成邊緣端開發。</p>
        </article>
      </div>
    </section>

    <!-- Call to Action -->
    <section class="cta-section">
      <div class="shell cta">
        <div>
          <p class="eyebrow">READY TO EXPLORE?</p>
          <h2>歡迎參閱完整的 GitHub 專案庫。</h2>
          <p>包含詳細的開發環境設定指南、腳位對照表與燒錄說明。</p>
        </div>
        <a class="button primary" href="https://github.com/fersz0614/esp32-sensors-mqtt-tft-epaper-Hsiang" target="_blank" rel="noreferrer">前往 GitHub 查看 ↗</a>
      </div>
    </section>
  </main>

  <footer class="footer shell">
    <span>ESP32 Lab · Smart Electronics Practice © 2026</span>
    <a href="https://github.com/fersz0614/esp32-sensors-mqtt-tft-epaper-Hsiang" target="_blank" rel="noreferrer">GitHub Repository ↗</a>
  </footer>

  <script src="app.js?v=6"></script>
  <script src="heic-preview.js?v=1"></script>
</body>
</html>
